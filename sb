#!/bin/sh

set -eu

PATH=${SB_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}
export PATH
umask 077

LIB_DIR=${SB_LIB_DIR:-/usr/local/lib/sb-manager}
# shellcheck source=lib/common.sh
. "$LIB_DIR/common.sh"
# shellcheck source=lib/platform.sh
. "$LIB_DIR/platform.sh"
# shellcheck source=lib/protocols.sh
. "$LIB_DIR/protocols.sh"
. "$LIB_DIR/protocols_extended.sh"
. "$LIB_DIR/caddy.sh"
. "$LIB_DIR/operations.sh"
. "$LIB_DIR/output.sh"
. "$LIB_DIR/migrate.sh"
. "$LIB_DIR/forward.sh"

VERSION=3.3.10

ui_interactive_terminal() {
  [ -t 0 ] && [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]
}

ui_setup() {
  [ "${UI_READY:-0}" = 1 ] && return 0
  UI_READY=1
  UI_RESET=
  UI_CYAN=
  UI_GREEN=
  UI_YELLOW=
  UI_RED=
  UI_MUTED=
  ui_interactive_terminal || return 0
  UI_RESET=$(printf '\033[0m')
  UI_CYAN=$(printf '\033[36m')
  UI_GREEN=$(printf '\033[32m')
  UI_YELLOW=$(printf '\033[33m')
  UI_RED=$(printf '\033[31m')
  UI_MUTED=$(printf '\033[2m')
}

ui_clear() {
  ui_interactive_terminal || return 0
  clear 2>/dev/null || printf '\033[H\033[2J'
}

ui_pause() {
  ui_interactive_terminal || return 0
  printf '\n%s按 Enter 返回主菜单...%s' "$UI_MUTED" "$UI_RESET"
  read -r ui_pause_input
}

ui_system_name() {
  if [ -r /etc/os-release ]; then
    (
      # shellcheck disable=SC1091
      . /etc/os-release
      printf '%s' "${PRETTY_NAME:-${NAME:-unknown}}"
    )
  else
    uname -s
  fi
}

ui_core_version() {
  sing-box version 2>/dev/null | awk 'NR==1 {print $3; exit}'
}

ui_count_files() {
  ui_directory=$1
  find "$ui_directory" -maxdepth 1 -type f -name '*.json' -print 2>/dev/null | wc -l | tr -d '[:space:]'
}

ui_service_badge() {
  if service_active; then
    printf '%s● 运行中%s' "$UI_GREEN" "$UI_RESET"
  else
    printf '%s○ 已停止%s' "$UI_RED" "$UI_RESET"
  fi
}

ui_print_header() {
  ui_setup
  ui_os=$(ui_system_name)
  ui_core=$(ui_core_version)
  ui_nodes=$(ui_count_files "$SB_NODE_DIR")
  ui_forwards=$(ui_count_files "$SB_FORWARD_DIR")
  [ -n "$ui_core" ] || ui_core=未检测到

  printf '\n%s   ____  ____%s\n' "$UI_CYAN" "$UI_RESET"
  printf '%s  / ___|| __ )   sb · sing-box 管理器%s\n' "$UI_CYAN" "$UI_RESET"
  printf '%s  \\___ \\|  _ \\  版本 %s%s\n' "$UI_CYAN" "$VERSION" "$UI_RESET"
  printf '%s  |____/|____/%s\n' "$UI_CYAN" "$UI_RESET"
  printf '%s  ─────────────────────────────────────────────%s\n' "$UI_MUTED" "$UI_RESET"
  printf '  系统 %s%s%s · 模式 %s%s%s · 核心 %s%s%s\n' \
    "$UI_CYAN" "$ui_os" "$UI_RESET" "$UI_CYAN" "$SB_PLATFORM" "$UI_RESET" "$UI_CYAN" "$ui_core" "$UI_RESET"
  printf '  服务 %s · 节点 %s%s%s · 转发 %s%s%s\n' \
    "$(ui_service_badge)" "$UI_GREEN" "$ui_nodes" "$UI_RESET" "$UI_GREEN" "$ui_forwards" "$UI_RESET"
  printf '%s  ─────────────────────────────────────────────%s\n' "$UI_MUTED" "$UI_RESET"
}

ui_section() {
  printf '\n%s【%s】%s\n' "$UI_CYAN" "$1" "$UI_RESET"
}

ui_main_menu_view() {
  ui_clear
  ui_print_header
  ui_section 节点管理
  printf '  %s[1]%s 添加节点      %s[2]%s 节点列表      %s[3]%s 节点详情\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[4]%s 导入链接      %s[5]%s 节点二维码    %s[6]%s 修改节点\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[7]%s 启用节点      %s[8]%s 禁用节点      %s[9]%s 重置密钥\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[10]%s 删除节点      %s[18]%s 删除全部节点\n' "$UI_RED" "$UI_RESET" "$UI_RED" "$UI_RESET"
  ui_section 服务与维护
  printf '  %s[11]%s 服务状态      %s[12]%s 重启服务      %s[13]%s 创建备份\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[14]%s 恢复备份      %s[15]%s 更新管理器    %s[16]%s 系统诊断\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  ui_section 网络工具
  printf '  %s[17]%s 动态端口转发\n' "$UI_GREEN" "$UI_RESET"
  printf '\n%s  ─────────────────────────────────────────────%s\n' "$UI_MUTED" "$UI_RESET"
  printf '  %s[0]%s 退出管理器\n\n' "$UI_YELLOW" "$UI_RESET"
}

ui_forward_menu_view() {
  ui_clear
  ui_print_header
  ui_section 动态端口转发
  printf '  %s[1]%s 添加规则      %s[2]%s 查看规则      %s[3]%s 修改规则\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[4]%s 启用规则      %s[5]%s 禁用规则      %s[6]%s 删除规则\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET" "$UI_RED" "$UI_RESET"
  printf '  %s[7]%s 解析并同步    %s[8]%s 后端状态\n' "$UI_GREEN" "$UI_RESET" "$UI_GREEN" "$UI_RESET"
  printf '  %s[9]%s 删除全部转发\n' "$UI_RED" "$UI_RESET"
  printf '\n%s  ─────────────────────────────────────────────%s\n' "$UI_MUTED" "$UI_RESET"
  printf '  %s[0]%s 返回主菜单\n\n' "$UI_YELLOW" "$UI_RESET"
}

usage() {
  cat <<'EOF'
Usage: sb COMMAND [arguments]

Node commands:
  sb add <anytls|ss2022|vless-reality|socks5> [options]
  sb change NAME [--listen-port PORT] [--public-address HOST] [--public-port PORT] [--username USER] [--password PASS]
  sb list
  sb info NAME
  sb url NAME
  sb qr NAME
  sb delete NAME [--yes]
  sb delete-all [--yes]

Service commands:
  sb start | stop | restart | status | check | log

Maintenance:
  sb backup [ARCHIVE]
  sb restore ARCHIVE
  sb update
  sb uninstall [--purge] [--remove-core] [--yes]

Port forwarding:
  sb forward add [options]
  sb forward change NAME [--listen-port PORT] [--target-host HOST]
                         [--target-port PORT] [--protocol tcp|udp|both]
  sb forward list | sync | enable NAME | disable NAME | delete NAME
  sb forward delete-all [--yes]

NAT example:
  sb add anytls --name tw --listen-port 30009 \
    --public-address 23.134.212.11 --public-port 64491
EOF
}

restart_and_verify() {
  previous_active=0
  service_active && previous_active=1 || true
  caddy_sync
  if [ "$previous_active" -eq 1 ]; then service_restart; else service_enable; service_start; fi
  service_active || return 1
}

commit_node_change() {
  name=$1
  staged_config=$2
  staged_meta=$3
  staged_cert_dir=${4:-}
  operation=$5

if [ "$operation" = delete ] || [ "$operation" = disable ]; then candidate=$(build_candidate_dir "$name" ""); else candidate=$(build_candidate_dir "$name" "$staged_config"); fi
  if [ -n "$staged_cert_dir" ] && [ -d "$staged_cert_dir" ]; then
    jq --arg cert "$staged_cert_dir/cert.pem" --arg key "$staged_cert_dir/key.pem" \
      '(.inbounds[0].tls.certificate_path)=$cert | (.inbounds[0].tls.key_path)=$key' \
      "$candidate/$name.json" >"$candidate/$name.validate.json"
    mv "$candidate/$name.validate.json" "$candidate/$name.json"
  fi
  validate_complete_config "$candidate"
  backup=$(mktemp -d /tmp/sb-rollback.XXXXXX)
  old_config=$(node_config_file "$name")
  old_meta=$(node_meta_file "$name")
  [ ! -f "$old_config" ] || cp "$old_config" "$backup/config.json"
  [ ! -f "$old_meta" ] || cp "$old_meta" "$backup/meta.json"
  [ ! -d "$SB_CERT_DIR/$name" ] || cp -R "$SB_CERT_DIR/$name" "$backup/certs"

  if [ "$operation" = delete ]; then
    rm -f "$old_config" "$old_meta"
    rm -rf "$SB_CERT_DIR/$name"
  elif [ "$operation" = disable ]; then
    rm -f "$old_config"
    install -m 0600 "$staged_meta" "$old_meta"
  else
    install -m 0640 "$staged_config" "$old_config"
    install -m 0600 "$staged_meta" "$old_meta"
    if [ -n "$staged_cert_dir" ] && [ -d "$staged_cert_dir" ]; then
      rm -rf "$SB_CERT_DIR/$name"
      install -d -m 0750 "$SB_CERT_DIR/$name"
      cp "$staged_cert_dir"/* "$SB_CERT_DIR/$name/"
      chmod 0644 "$SB_CERT_DIR/$name/cert.pem"
      chmod 0640 "$SB_CERT_DIR/$name/key.pem"
    fi
  fi

  if getent group sing-box >/dev/null 2>&1; then
    chown -R root:sing-box "$SB_CONF_DIR" "$SB_CERT_DIR"
  fi

  if ! restart_and_verify; then
    rm -f "$old_config" "$old_meta"
    rm -rf "$SB_CERT_DIR/$name"
    [ ! -f "$backup/config.json" ] || cp "$backup/config.json" "$old_config"
    [ ! -f "$backup/meta.json" ] || cp "$backup/meta.json" "$old_meta"
    [ ! -d "$backup/certs" ] || cp -R "$backup/certs" "$SB_CERT_DIR/$name"
    service_restart >/dev/null 2>&1 || true
    rm -rf "$candidate" "$backup"
    die 'service verification failed; previous node state restored'
  fi
  rm -rf "$candidate" "$backup"
}

command_add() {
  [ "$#" -ge 1 ] || die 'protocol is required'
  protocol=$1
  shift
  case "$protocol" in anytls|ss2022|vless-reality|socks5|hysteria2|tuic|trojan|vmess|vless-tls) ;; *) die 'unsupported protocol' ;; esac

  name=
  listen_address=0.0.0.0
  listen_port=
  public_address=$(manager_server_address)
  public_port=
  username=default
  password=
  ss_method=2022-blake3-aes-128-gcm
  reality_server=www.microsoft.com
  reality_port=443
  cert_source=
  key_source=
  transport=tcp
  path=/proxy
  host=
  tls_mode=
  acme_email=
  obfs_password=

  while [ "$#" -gt 0 ]; do
    [ "$#" -ge 2 ] || die "add option requires a value: $1"
    case "$1" in
      --name) name=$2; shift 2 ;;
      --listen-address|--listen) listen_address=$2; shift 2 ;;
      --listen-port|--port) listen_port=$2; shift 2 ;;
      --public-address|--server-address) public_address=$2; shift 2 ;;
      --public-port) public_port=$2; shift 2 ;;
      --username) username=$2; shift 2 ;;
      --password) password=$2; shift 2 ;;
      --ss-method) ss_method=$2; shift 2 ;;
      --reality-server) reality_server=$2; shift 2 ;;
      --reality-port) reality_port=$2; shift 2 ;;
      --cert) cert_source=$2; shift 2 ;;
      --key) key_source=$2; shift 2 ;;
      --transport) transport=$2; shift 2 ;;
      --path) path=$2; shift 2 ;;
      --host) host=$2; shift 2 ;;
      --tls-mode) tls_mode=$2; shift 2 ;;
      --acme-email) acme_email=$2; shift 2 ;;
      --obfs-password) obfs_password=$2; shift 2 ;;
      *) die "unknown add option: $1" ;;
    esac
  done

  [ -n "$listen_port" ] || listen_port=$(protocol_default_port_all "$protocol")
  [ -n "$host" ] || host=$public_address
  [ -n "$public_port" ] || public_port=$listen_port
  [ -n "$name" ] || name="$protocol-$listen_port"
  validate_name "$name" || die 'invalid node name'
  validate_host "$public_address" || die 'invalid public address'
  is_ipv4 "$listen_address" || die 'listen address must be IPv4'
  validate_port "$listen_port" || die 'invalid listen port'
  validate_port "$public_port" || die 'invalid public port'
  validate_port "$reality_port" || die 'invalid REALITY port'
  validate_host "$reality_server" || die 'invalid REALITY server'
  node_exists "$name" && die "node already exists: $name"
  port_in_metadata "$listen_port" '' && die "listen port already managed: $listen_port"

  work=$(mktemp -d /tmp/sb-add.XXXXXX)
  meta=$work/meta.json
  config=$work/config.json
  cert_stage=$work/certs
  protocol_generate "$meta" "$protocol" "$name" "$listen_address" "$listen_port" \
    "$public_address" "$public_port" "$username" "$password" "$ss_method" \
    "$reality_server" "$reality_port" "$cert_source" "$key_source" "$cert_stage" \
    "$transport" "$path" "$host" "$tls_mode" "$acme_email" "$obfs_password"
  protocol_render "$meta" "$config"
  commit_node_change "$name" "$config" "$meta" "$cert_stage" add
  rm -rf "$work"
  info "节点已添加: $name"
  say '节点导入链接（包含密码，请妥善保管）:'
  command_url "$name"
}

command_list() {
  printf '%-24s %-16s %-9s %-18s %-18s\n' 节点名称 协议 状态 内部监听 公网地址
  for name in $(list_node_names); do
    meta=$(node_meta_file "$name")
    printf '%-24s %-16s %-9s %-18s %-18s\n' \
      "$name" "$(jq -r '.protocol' "$meta")" "$(jq -r 'if has("enabled") then .enabled else true end' "$meta")" \
      "$(jq -r '.listen.address+":"+(.listen.port|tostring)' "$meta")" \
      "$(jq -r '.public.address+":"+(.public.port|tostring)' "$meta")"
  done
}

command_info() {
  [ "$#" -ge 1 ] || die 'node name is required'
  info_name=$1; shift
  info_show=0
  [ "${1:-}" != --show-secrets ] || info_show=1
  node_exists "$info_name" || die "node not found: $info_name"
  info_meta=$(node_meta_file "$info_name")
  if [ "$info_show" -eq 1 ]; then
    jq . "$info_meta"
    say '分享链接:'
    protocol_share_uri "$info_meta"
  else
    jq 'del(.credentials.password,.reality.private_key) | if .credentials.uuid then .credentials.uuid="***" else . end | if .reality.public_key then .reality.public_key="***" else . end' "$info_meta"
    say '使用 `sb info 节点名 --show-secrets` 或 `sb url 节点名` 查看完整凭据。'
  fi
}

command_url() {
  [ "$#" -eq 1 ] || die 'node name is required'
  node_exists "$1" || die "node not found: $1"
  protocol_share_uri "$(node_meta_file "$1")"
}

command_qr() {
  url=$(command_url "$@")
  if command -v qrencode >/dev/null 2>&1; then qrencode -t ANSIUTF8 "$url"; else say "$url"; warn '未安装 qrencode，已直接输出链接'; fi
}

command_delete() {
  [ "$#" -ge 1 ] || die 'node name is required'
  name=$1
  shift
  yes=0
  [ "${1:-}" != --yes ] || yes=1
  node_exists "$name" || die "node not found: $name"
  [ "$yes" -eq 1 ] || confirm "确定删除节点 $name 吗？" || return 0
  empty=$(mktemp /tmp/sb-empty.XXXXXX)
  : >"$empty"
  commit_node_change "$name" "$empty" "$empty" '' delete
  rm -f "$empty"
  info "节点已删除: $name"
}

command_delete_all() {
  delete_all_yes=0
  case "${1:-}" in
    --yes) delete_all_yes=1; shift ;;
  esac
  [ "$#" -eq 0 ] || die 'usage: sb delete-all [--yes]'

  delete_all_names=$(list_node_names)
  [ -n "$delete_all_names" ] || { info '没有可删除的节点'; return 0; }
  delete_all_count=$(printf '%s\n' "$delete_all_names" | wc -l | tr -d '[:space:]')
  [ "$delete_all_yes" -eq 1 ] || confirm "确定删除全部 $delete_all_count 个节点及其配置吗？" || return 0

  delete_all_candidate=$(mktemp -d /tmp/sb-delete-all-candidate.XXXXXX)
  for delete_all_config in "$SB_CONF_DIR"/*.json; do
    [ -f "$delete_all_config" ] || continue
    delete_all_config_name=${delete_all_config##*/}
    delete_all_config_name=${delete_all_config_name%.json}
    node_exists "$delete_all_config_name" && continue
    cp "$delete_all_config" "$delete_all_candidate/$delete_all_config_name.json"
  done
  if ! validate_complete_config "$delete_all_candidate"; then
    rm -rf "$delete_all_candidate"
    die '删除全部节点后的配置校验失败'
  fi
  rm -rf "$delete_all_candidate"

  delete_all_backup=$(mktemp -d /tmp/sb-delete-all.XXXXXX)
  install -d -m 0700 "$delete_all_backup/conf.d" "$delete_all_backup/nodes" "$delete_all_backup/certs"
  delete_all_previous_active=0
  service_active && delete_all_previous_active=1 || true
  for delete_all_name in $delete_all_names; do
    [ ! -f "$(node_config_file "$delete_all_name")" ] || cp "$(node_config_file "$delete_all_name")" "$delete_all_backup/conf.d/$delete_all_name.json"
    cp "$(node_meta_file "$delete_all_name")" "$delete_all_backup/nodes/$delete_all_name.json"
    [ ! -d "$SB_CERT_DIR/$delete_all_name" ] || cp -R "$SB_CERT_DIR/$delete_all_name" "$delete_all_backup/certs/$delete_all_name"
    rm -f "$(node_config_file "$delete_all_name")" "$(node_meta_file "$delete_all_name")"
    rm -rf "$SB_CERT_DIR/$delete_all_name"
  done

  if caddy_sync && restart_and_verify; then
    rm -rf "$delete_all_backup"
    info "已删除全部 $delete_all_count 个节点"
    return 0
  fi

  for delete_all_name in $delete_all_names; do
    rm -f "$(node_config_file "$delete_all_name")" "$(node_meta_file "$delete_all_name")"
    rm -rf "$SB_CERT_DIR/$delete_all_name"
    [ ! -f "$delete_all_backup/conf.d/$delete_all_name.json" ] || cp "$delete_all_backup/conf.d/$delete_all_name.json" "$(node_config_file "$delete_all_name")"
    cp "$delete_all_backup/nodes/$delete_all_name.json" "$(node_meta_file "$delete_all_name")"
    [ ! -d "$delete_all_backup/certs/$delete_all_name" ] || cp -R "$delete_all_backup/certs/$delete_all_name" "$SB_CERT_DIR/$delete_all_name"
  done
  caddy_sync || true
  if [ "$delete_all_previous_active" -eq 1 ]; then service_restart || true; else service_stop || true; fi
  rm -rf "$delete_all_backup"
  warn '删除全部节点失败，已恢复原节点配置'
  return 1
}

command_change() {
  [ "$#" -ge 1 ] || die 'node name is required'
  name=$1
  shift
  node_exists "$name" || die "node not found: $name"
  source_meta=$(node_meta_file "$name")
  listen_port=$(jq -r '.listen.port' "$source_meta")
  public_address=$(jq -r '.public.address' "$source_meta")
  public_port=$(jq -r '.public.port' "$source_meta")
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --listen-port|--port) listen_port=$2; shift 2 ;;
      --public-address|--server-address) public_address=$2; shift 2 ;;
      --public-port) public_port=$2; shift 2 ;;
      *) die "unknown change option: $1" ;;
    esac
  done
  validate_port "$listen_port" || die 'invalid listen port'
  validate_port "$public_port" || die 'invalid public port'
  validate_host "$public_address" || die 'invalid public address'
  port_in_metadata "$listen_port" "$name" && die "listen port already managed: $listen_port"
  work=$(mktemp -d /tmp/sb-change.XXXXXX)
  jq --argjson listen_port "$listen_port" --arg public_address "$public_address" \
    --argjson public_port "$public_port" --arg updated_at "$(timestamp)" \
    '.listen.port=$listen_port | .public.address=$public_address | .public.port=$public_port | .updated_at=$updated_at' \
    "$source_meta" >"$work/meta.json"
  protocol_render "$work/meta.json" "$work/config.json"
cert_stage=
  protocol=$(jq -r '.protocol' "$source_meta")
  old_public_address=$(jq -r '.public.address' "$source_meta")
  tls_mode=$(jq -r '.tls.mode // empty' "$source_meta")
  if [ "$protocol" = anytls ] && [ "$tls_mode" = self-signed ] && [ "$old_public_address" != "$public_address" ]; then
    cert_stage="$work/certs"
    install -d -m 0700 "$cert_stage"
    if is_ipv4 "$public_address"; then san="IP:$public_address"; else san="DNS:$public_address"; fi
    openssl ecparam -genkey -name prime256v1 -out "$cert_stage/key.pem"
    openssl req -new -x509 -key "$cert_stage/key.pem" -sha256 -days 3650 \
      -out "$cert_stage/cert.pem" -subj "/CN=$public_address" -addext "subjectAltName=$san"
    chmod 0640 "$cert_stage/key.pem"
    chmod 0644 "$cert_stage/cert.pem"
  fi
  commit_node_change "$name" "$work/config.json" "$work/meta.json" "$cert_stage" change
  rm -rf "$work"
  info "节点已修改: $name"
  command_info "$name"
}

command_check() {
  sing-box check -c "$SB_BASE_CONFIG" -C "$SB_CONF_DIR"
}

command_backup() {
  archive=${1:-/root/sb-backup-$(timestamp).tar.gz}
  case "$archive" in /*) ;; *) archive="$(pwd)/$archive" ;; esac
  tar -C / -czf "$archive" "${SB_HOME#/}" "${SB_RUNTIME_DIR#/}" usr/local/bin/sb
  chmod 0600 "$archive"
  sha256sum "$archive" >"$archive.sha256"
  chmod 0600 "$archive.sha256"
  info "Backup created: $archive"
}

command_restore() {
  [ "$#" -eq 1 ] || die 'backup archive is required'
  archive=$1
  [ -r "$archive" ] || die 'backup archive is not readable'
  tar -tzf "$archive" | grep -Eq '(^/|(^|/)\.\.(/|$))' && die 'unsafe backup archive paths'
  backup_before=/root/sb-before-restore-$(timestamp).tar.gz
  command_backup "$backup_before"
  tar -C / -xzf "$archive"
  command_check || { warn "restore validation failed; restoring $backup_before"; tar -C / -xzf "$backup_before"; die 'restore failed'; }
  restart_and_verify
  info 'Backup restored.'
}

command_update() {
  tmp=$(mktemp -d /tmp/sb-update.XXXXXX)
  curl -fsSL https://github.com/kukumi1/sing-box/archive/refs/heads/main.tar.gz -o "$tmp/source.tar.gz"
  tar -C "$tmp" -xzf "$tmp/source.tar.gz"
  source_dir=$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -n 1)
  sh "$source_dir/install.sh" --upgrade
  rm -rf "$tmp"
  info 'Manager updated.'
}

command_uninstall() {
  purge=0
  remove_core=0
  yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in --purge) purge=1 ;; --remove-core) remove_core=1 ;; --yes) yes=1 ;; *) die "unknown uninstall option: $1" ;; esac
    shift
  done
  [ "$yes" -eq 1 ] || confirm 'Uninstall sb manager?' || return 0
  service_active && service_stop || true
  service_enabled && service_disable || true
  forward_uninstall
  if [ "$SB_PLATFORM" = alpine ]; then rm -f /etc/init.d/sb-sing-box; else rm -f /etc/systemd/system/sb-sing-box.service; systemctl daemon-reload; fi
  rm -f /usr/local/bin/sb
  rm -rf "$SB_RUNTIME_DIR"
  [ "$purge" -eq 0 ] || rm -rf "$SB_HOME"
  if [ "$remove_core" -eq 1 ]; then
    if [ "$SB_PLATFORM" = alpine ]; then apk del sing-box sing-box-openrc || true; else apt-get remove -y sing-box || true; fi
  fi
  info 'sb 管理器已卸载'
}

interactive_select_ss2022_method() {
  ss_menu_empty=$1
  cat <<'EOF'

请选择 SS2022 加密方式：
1) 2022-blake3-aes-128-gcm（默认，16 字节密钥）
2) 2022-blake3-aes-256-gcm（32 字节密钥）
3) 2022-blake3-chacha20-poly1305（32 字节密钥）
EOF
  if [ "$ss_menu_empty" = keep ]; then
    printf '请输入加密方式编号（留空则不修改）: '
  else
    printf '请输入加密方式编号（留空使用默认）: '
  fi
  read -r ss_menu_choice
  case "$ss_menu_choice" in
    '')
      if [ "$ss_menu_empty" = keep ]; then menu_ss_method=; else menu_ss_method=2022-blake3-aes-128-gcm; fi
      ;;
    1) menu_ss_method=2022-blake3-aes-128-gcm ;;
    2) menu_ss_method=2022-blake3-aes-256-gcm ;;
    3) menu_ss_method=2022-blake3-chacha20-poly1305 ;;
    *) warn '无效的 SS2022 加密方式编号'; return 1 ;;
  esac
}

interactive_add_node() {
  cat <<'EOF'

请选择节点协议：
1) AnyTLS
2) Shadowsocks 2022
3) VLESS + REALITY
4) SOCKS5
5) Hysteria2
6) TUIC
7) Trojan
8) VMess
9) VLESS TLS
0) 返回主菜单
EOF
  printf '请输入协议编号: '
  read -r protocol_choice
  case "$protocol_choice" in
    1) menu_protocol=anytls ;;
    2) menu_protocol=ss2022 ;;
    3) menu_protocol=vless-reality ;;
    4) menu_protocol=socks5 ;;
    5) menu_protocol=hysteria2 ;;
    6) menu_protocol=tuic ;;
    7) menu_protocol=trojan ;;
    8) menu_protocol=vmess ;;
    9) menu_protocol=vless-tls ;;
    0) return 0 ;;
    *) warn '无效的协议编号'; return 1 ;;
  esac

  printf '节点名称（留空则自动生成）: '
  read -r menu_name
  printf '内部监听端口（留空则使用默认端口）: '
  read -r menu_listen_port
  printf '客户端连接的公网 IP 或域名（留空使用安装时设置）: '
  read -r menu_public_address
  printf 'NAT 映射后的公网端口（留空则与内部端口相同）: '
  read -r menu_public_port
  menu_username=
  menu_password=
  menu_ss_method=
  if [ "$menu_protocol" = ss2022 ]; then
    interactive_select_ss2022_method default || return 1
  fi
  if [ "$menu_protocol" = socks5 ]; then
    printf 'SOCKS5 用户名（留空使用 default）: '
    read -r menu_username
    printf 'SOCKS5 密码（留空自动生成）: '
    read -r menu_password
  fi

  set -- "$menu_protocol"
  [ -z "$menu_name" ] || set -- "$@" --name "$menu_name"
  [ -z "$menu_listen_port" ] || set -- "$@" --listen-port "$menu_listen_port"
  [ -z "$menu_public_address" ] || set -- "$@" --public-address "$menu_public_address"
  [ -z "$menu_public_port" ] || set -- "$@" --public-port "$menu_public_port"
  [ -z "$menu_username" ] || set -- "$@" --username "$menu_username"
  [ -z "$menu_password" ] || set -- "$@" --password "$menu_password"
  [ -z "$menu_ss_method" ] || set -- "$@" --ss-method "$menu_ss_method"
  command_add "$@"
}

interactive_select_node() {
  menu_nodes=$(list_node_names)
  if [ -z "$menu_nodes" ]; then
    warn '当前没有已创建的节点'
    return 1
  fi

  say ''
  say '请选择节点：'
  menu_index=1
  for menu_node in $menu_nodes; do
    menu_meta=$(node_meta_file "$menu_node")
    menu_protocol=$(jq -r '.protocol' "$menu_meta")
    menu_public=$(jq -r '.public.address+":"+(.public.port|tostring)' "$menu_meta")
    printf '%s) %s  [%s]  %s\n' "$menu_index" "$menu_node" "$menu_protocol" "$menu_public"
    menu_index=$((menu_index + 1))
  done
  say '0) 返回主菜单'
  printf '请输入节点序号: '
  read -r menu_selection
  [ "$menu_selection" != 0 ] || return 1
  case "$menu_selection" in ''|*[!0-9]*) warn '无效的节点序号'; return 1 ;; esac

  menu_index=1
  menu_selected_node=
  for menu_node in $menu_nodes; do
    if [ "$menu_index" -eq "$menu_selection" ]; then
      menu_selected_node=$menu_node
      break
    fi
    menu_index=$((menu_index + 1))
  done
  [ -n "$menu_selected_node" ] || { warn '节点序号不存在'; return 1; }
  return 0
}

interactive_select_forward() {
  menu_forward_names=$(forward_list_names)
  if [ -z "$menu_forward_names" ]; then
    warn '当前没有端口转发规则'
    return 1
  fi
  say ''
  say '请选择端口转发规则：'
  menu_forward_index=1
  for menu_forward_name in $menu_forward_names; do
    menu_forward_file=$(forward_config_file "$menu_forward_name")
    menu_forward_listen=$(jq -r '.listen_port' "$menu_forward_file")
    menu_forward_target=$(jq -r '.target.host+":"+(.target.port|tostring)' "$menu_forward_file")
    menu_forward_protocol=$(jq -r '.protocols|join("+")' "$menu_forward_file")
    printf '%s) %s  [%s]  %s -> %s\n' "$menu_forward_index" "$menu_forward_name" "$menu_forward_protocol" "$menu_forward_listen" "$menu_forward_target"
    menu_forward_index=$((menu_forward_index + 1))
  done
  say '0) 返回'
  printf '请输入规则序号: '
  read -r menu_forward_selection
  [ "$menu_forward_selection" != 0 ] || return 1
  case "$menu_forward_selection" in ''|*[!0-9]*) warn '无效的规则序号'; return 1 ;; esac
  menu_forward_index=1
  menu_selected_forward=
  for menu_forward_name in $menu_forward_names; do
    if [ "$menu_forward_index" -eq "$menu_forward_selection" ]; then menu_selected_forward=$menu_forward_name; break; fi
    menu_forward_index=$((menu_forward_index + 1))
  done
  [ -n "$menu_selected_forward" ] || { warn '规则序号不存在'; return 1; }
}

interactive_forward_menu() {
  while :; do
    ui_forward_menu_view
    printf '%s请选择操作 [0-9]: %s' "$UI_YELLOW" "$UI_RESET"
    read -r forward_choice
    case "$forward_choice" in
      1)
        printf '规则名称（留空自动生成）: '; read -r forward_name
        printf '本机内部监听端口: '; read -r forward_listen
        printf '目标域名或 IPv4: '; read -r forward_host
        printf '目标端口（留空与本机端口相同）: '; read -r forward_target
        printf '协议 tcp/udp/both（留空默认 both）: '; read -r forward_protocol
        set -- --listen-port "$forward_listen" --target-host "$forward_host" --protocol "${forward_protocol:-both}"
        [ -z "$forward_name" ] || set -- "$@" --name "$forward_name"
        [ -z "$forward_target" ] || set -- "$@" --target-port "$forward_target"
        command_forward add "$@"
        ;;
      2) command_forward list ;;
      3)
        if interactive_select_forward; then
          forward_edit_file=$(forward_config_file "$menu_selected_forward")
          forward_edit_listen=$(jq -r '.listen_port' "$forward_edit_file")
          forward_edit_host=$(jq -r '.target.host' "$forward_edit_file")
          forward_edit_target=$(jq -r '.target.port' "$forward_edit_file")
          forward_edit_protocol=$(jq -r 'if (.protocols | length) == 2 then "both" else .protocols[0] end' "$forward_edit_file")
          printf '新的本机内部监听端口（当前 %s，留空不修改）: ' "$forward_edit_listen"; read -r forward_listen
          printf '新的目标域名或 IPv4（当前 %s，留空不修改）: ' "$forward_edit_host"; read -r forward_host
          printf '新的目标端口（当前 %s，留空不修改）: ' "$forward_edit_target"; read -r forward_target
          printf '新的协议 tcp/udp/both（当前 %s，留空不修改）: ' "$forward_edit_protocol"; read -r forward_protocol
          set -- "$menu_selected_forward"
          forward_edit_requested=0
          if [ -n "$forward_listen" ]; then set -- "$@" --listen-port "$forward_listen"; forward_edit_requested=1; fi
          if [ -n "$forward_host" ]; then set -- "$@" --target-host "$forward_host"; forward_edit_requested=1; fi
          if [ -n "$forward_target" ]; then set -- "$@" --target-port "$forward_target"; forward_edit_requested=1; fi
          if [ -n "$forward_protocol" ]; then set -- "$@" --protocol "$forward_protocol"; forward_edit_requested=1; fi
          if [ "$forward_edit_requested" -eq 1 ]; then command_forward change "$@"; else info '未修改转发规则'; fi
        fi
        ;;
      4) if interactive_select_forward; then command_forward enable "$menu_selected_forward"; fi ;;
      5) if interactive_select_forward; then command_forward disable "$menu_selected_forward"; fi ;;
      6) if interactive_select_forward && confirm "确定删除转发规则 $menu_selected_forward 吗？"; then command_forward delete "$menu_selected_forward"; fi ;;
      7) command_forward sync ;;
      8) command_forward status ;;
      9) command_forward delete-all ;;
      0) return 0 ;;
      *) warn '无效的选项，请重新输入' ;;
    esac
    ui_pause
  done
}

interactive_menu() {
  while :; do
    ui_main_menu_view
    printf '%s请选择操作 [0-18]: %s' "$UI_YELLOW" "$UI_RESET"
    read -r choice
    case "$choice" in
      1) interactive_add_node ;;
      2) command_list ;;
      3) if interactive_select_node; then command_info "$menu_selected_node"; fi ;;
      4) if interactive_select_node; then say '节点导入链接（包含密码，请妥善保管）:'; command_url "$menu_selected_node"; fi ;;
      5) if interactive_select_node; then command_qr "$menu_selected_node"; fi ;;
      6)
        interactive_select_node || continue
        name=$menu_selected_node
        protocol=$(jq -r '.protocol' "$(node_meta_file "$name")")
        listen_port=$(jq -r '.listen.port' "$(node_meta_file "$name")")
        printf '新的内部监听端口（当前 %s，留空则不修改）: ' "$listen_port"; read -r listen_port
        printf '新的公网 IP 或域名（留空则不修改）: '; read -r address
        printf '新的公网端口（留空则不修改）: '; read -r port
        username=
        password=
        ss_method=
        if [ "$protocol" = socks5 ]; then
          printf '新的 SOCKS5 用户名（留空则不修改）: '; read -r username
          printf '新的 SOCKS5 密码（留空则不修改）: '; read -r password
        elif [ "$protocol" = ss2022 ]; then
          say '切换 SS2022 加密方式会自动生成新的匹配密钥。'
          interactive_select_ss2022_method keep || continue
          ss_method=$menu_ss_method
        fi
        set -- "$name"
        [ -z "$listen_port" ] || set -- "$@" --listen-port "$listen_port"
        [ -z "$address" ] || set -- "$@" --public-address "$address"
        [ -z "$port" ] || set -- "$@" --public-port "$port"
        [ -z "$username" ] || set -- "$@" --username "$username"
        [ -z "$password" ] || set -- "$@" --password "$password"
        [ -z "$ss_method" ] || set -- "$@" --ss-method "$ss_method"
        command_change "$@"
        ;;
      7) if interactive_select_node; then command_enable "$menu_selected_node"; fi ;;
      8) if interactive_select_node; then command_disable "$menu_selected_node"; fi ;;
      9) if interactive_select_node; then command_rotate "$menu_selected_node"; fi ;;
      10) if interactive_select_node; then command_delete "$menu_selected_node"; fi ;;
      11) service_status ;;
      12) service_restart; info '服务已重启' ;;
      13) command_backup ;;
      14) printf '请输入备份文件完整路径: '; read -r archive; command_restore "$archive" ;;
      15) command_update manager ;;
      16) command_doctor ;;
      17) interactive_forward_menu; continue ;;
      18) command_delete_all ;;
      0) return 0 ;;
      *) warn '无效的选项，请重新输入' ;;
    esac
    ui_pause
  done
}

. "$LIB_DIR/output.sh"
. "$LIB_DIR/change.sh"
. "$LIB_DIR/maintenance.sh"

require_root
require_command jq
require_command sing-box
detect_platform
case "${1:-}:${2:-}" in
  forward:sync|forward:install-scheduler) ;;
  *) acquire_lock ;;
esac

[ "$#" -gt 0 ] || { interactive_menu; exit 0; }
command=$1
shift
case "$command" in
  add) command_add "$@" ;;
  forward) command_forward "$@" ;;
  migrate) command_migrate "$@" ;;
  enable) command_enable "$@" ;;
  disable) command_disable "$@" ;;
  rotate) command_rotate "$@" ;;
  export) command_export "$@" ;;
  client) command_client "$@" ;;
  snapshot) command_snapshot "$@" ;;
  rollback) command_rollback_release "$@" ;;
  manager-rollback) command_manager_rollback ;;
  core) command_core "$@" ;;
  doctor) command_doctor "$@" ;;
  bbr) command_bbr "$@" ;;
  dns) command_dns "$@" ;;
  caddy) case "${1:-status}" in sync) caddy_sync ;; status) caddy_status ;; log) caddy_logs "${2:-100}" ;; *) die "usage: sb caddy sync|status|log" ;; esac ;;
  change) command_change "$@" ;;
  list|ls) command_list ;;
  info) command_info "$@" ;;
  url) command_url "$@" ;;
  qr) command_qr "$@" ;;
  delete|del|rm) command_delete "$@" ;;
  delete-all|purge) command_delete_all "$@" ;;
  start) service_enable; service_start ;;
  stop) service_stop ;;
  restart) service_restart ;;
  status) service_status ;;
  check) command_check ;;
  log|logs) service_logs "${1:-100}" ;;
  backup) command_backup "$@" ;;
  restore) command_restore "$@" ;;
  update) command_update ;;
  uninstall) command_uninstall "$@" ;;
  help|-h|--help) usage ;;
  version|--version) say "$VERSION" ;;
  *) usage; die "unknown command: $command" ;;
esac
